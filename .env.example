# Copy to .env.local and fill in as needed. Nothing here is required yet —
# the app runs with zero environment variables configured.

# Public site URL, used to build absolute metadata (Open Graph, canonical
# URLs). Defaults to http://localhost:3000 in src/config/site.ts if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Planned, not yet integrated ---
# Supabase lands with the accounts/progress phase (see README roadmap).
# Do not add real values for these until that phase begins.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
